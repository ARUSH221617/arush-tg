# ==========================================
# Arush Manager Agent Environment Settings
# ==========================================

# 1. Telegram Bot Credentials
TELEGRAM_BOT_TOKEN=9006529162:AAGOXEb8Jq_ERM739fsTaHOckEIdTnzFyPc
# Put your personal Telegram numeric user ID here:
ALLOWED_TELEGRAM_USER_IDS=123456789

# Local proxy for Telegram API in Iran (e.g. socks5://127.0.0.1:10808 or http://127.0.0.1:10809)
TELEGRAM_PROXY=

# 2. 9Router Gateway Configuration
NINEROUTER_URL=http://localhost:20128
NINEROUTER_KEY=

# 3. Default Models (ALL CHANGEABLE HERE)
# Chat/Agent Model: e.g. anthropic/claude-3-7-sonnet, anthropic/claude-3-5-sonnet, gemini/gemini-2.5-flash, openai/gpt-4o
AGENT_MODEL=anthropic/claude-3-7-sonnet

# Speech-to-Text Model for Telegram voice notes: e.g. groq/whisper-large-v3-turbo, openai/whisper-1, gemini/gemini-2.5-flash
STT_MODEL=groq/whisper-large-v3-turbo

# Image Generation Model: e.g. black-forest-labs/flux-1-schnell, openai/dall-e-3, gemini/gemini-3-pro-image-preview, comfyui
IMAGE_MODEL=black-forest-labs/flux-1-schnell

# Embeddings Model for Vault vector search: e.g. openai/text-embedding-3-small
EMBEDDING_MODEL=openai/text-embedding-3-small

# 4. Local Integrations
COMFYUI_URL=http://127.0.0.1:8188
VAULT_DATA_DIR=d:\arush\arush-tg\data
