# 2. 9Router Gateway Configuration
NINEROUTER_URL=http://localhost:20128
NINEROUTER_KEY=

# 3. Default Models (Configurable per capability) & Agent Loop Controls
SYSTEM_ONE_MODEL=oc/jev-1.13-free
AGENT_MODEL=anthropic/claude-3-7-sonnet
AGENT_MAX_TURNS=200
AGENT_TOOL_REPEAT_LIMIT=3
STT_MODEL=groq/whisper-large-v3-turbo
IMAGE_MODEL=black-forest-labs/flux-1-schnell
EMBEDDING_MODEL=openai/text-embedding-3-small

# 4. Freelance Radar (Phase 3)
RADAR_POLL_INTERVAL_SECONDS=600
RADAR_SYSTEM_ONE_BATCH_SIZE=20
RADAR_SYSTEM_ONE_THRESHOLD=0.55
RADAR_MIN_BUDGET_TOMAN=1000000
RADAR_CATEGORIES=python,react,bot,ai,web scraping,telegram,fastapi,django,automation
RADAR_MATCH_THRESHOLD=80

# 5. Browser & GitHub Integration (Phase 4)
CHROME_USER_DATA_DIR=
CHROME_PROFILE_NAME=Default
BROWSER_HEADLESS=false
GITHUB_TOKEN=
GITHUB_DEFAULT_REPO=arush221617/arush-tg

# 6. Local Integrations & Vault Storage (Phase 2 & 5)
COMFYUI_URL=http://127.0.0.1:8188
VAULT_DATA_DIR=./data

# 7. Daily Routines & Self-Healing Daemon (Phase 6 & 7)
# Tehran Timezone (IRST UTC+3:30 - Daylight Saving Time is abolished in Iran)
TIMEZONE_OFFSET_HOURS=3.5
MORNING_BRIEFING_TIME=08:30
NIGHTLY_REVIEW_TIME=22:30
BACKUP_TIME=03:00
BACKUP_RETENTION_DAYS=14
HEALTHCHECK_PORT=8089
HEARTBEAT_INTERVAL_SECONDS=60
